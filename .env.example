# Copy to .env.local for local development. Never commit real values.
# On Vercel these are set by the Supabase integration or by hand (see README).

# Required — public, safe in the browser (RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy alternative to the publishable key (used only if the one above is missing):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Not used in Phase 0. Server-only from Phase 1 (admin tasks, seed). Never prefix with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=sb_secret_...
